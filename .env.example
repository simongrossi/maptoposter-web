# =============================================================================
# MapPoster Web - configuration d'exploitation
# =============================================================================
# 1. Copier ce fichier :            cp .env.example .env
# 2. Generer les secrets :          ./scripts/init-env.sh
#    (ou renseigner a la main chaque variable vide avec `openssl rand -hex 32`)
# 3. Proteger le fichier :          chmod 600 .env
#
# Aucune valeur secrete n'est fournie ici. Compose refuse de demarrer tant que
# les variables obligatoires sont vides (operateur ":?" dans docker-compose.yml).
# Ne jamais committer .env : il est deja ignore par .gitignore.
# =============================================================================

# --- Identite du projet Compose ---------------------------------------------
COMPOSE_PROJECT_NAME=maptoposter

# --- URL publique ------------------------------------------------------------
# Laisser vide pour que l'API renvoie des URLs signees relatives
# (/api/download/...), resolues par le navigateur sur l'origine courante.
# Renseigner l'URL HTTPS publique si l'application est servie derriere Caddy :
#   PUBLIC_BASE_URL=https://posters.example.com
PUBLIC_BASE_URL=

# --- Redis -------------------------------------------------------------------
# Obligatoire. 32 octets aleatoires en hexadecimal (openssl rand -hex 32).
# Format hexa imperatif : le mot de passe est insere dans une URL redis://.
REDIS_PASSWORD=

# --- Stockage S3 prive (VersityGW) ------------------------------------------
# Obligatoires. Ne pas reutiliser les anciens identifiants MinIO.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=posters
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://storage:8333

# --- Sessions anonymes et URLs signees --------------------------------------
# Deux secrets HMAC distincts, 32 octets hexa minimum chacun.
SESSION_SECRET=
DOWNLOAD_SIGNING_SECRET=

# Duree de vie d'une session anonyme (secondes) : 7 jours.
SESSION_TTL=604800
# Duree de vie d'une URL de telechargement signee (secondes) : 15 minutes.
DOWNLOAD_URL_TTL=900

# --- Quotas et plafonds de rendu --------------------------------------------
# Limite de debit SlowAPI sur POST /generate (format "<n>/<periode>").
GENERATE_RATE_LIMIT=5/minute
# Nombre de generations acceptees par IP et par jour.
DAILY_GENERATE_QUOTA=50
# Generations simultanees autorisees pour une meme session.
MAX_ACTIVE_JOBS_PER_SESSION=2
# Taches en attente maximum dans la file Celery (toutes sessions confondues).
MAX_QUEUED_JOBS=20
# Rayon maximal de la carte en metres (25 km : 50 x 50 km de donnees OSM).
MAX_DISTANCE_METERS=25000
# Plafond de pixels de sortie (largeur x hauteur x dpi^2).
MAX_OUTPUT_PIXELS=100000000
# Dimensions maximales d'une affiche en pouces.
MAX_IMAGE_DIMENSION_INCHES=40
# DPI maximal accepte.
MAX_RENDER_DPI=600

# --- Retention du stockage ---------------------------------------------------
# Suppression des affiches plus anciennes que N jours (0 = desactive).
POSTER_RETENTION_DAYS=7
# Nombre maximal d'objets conserves (0 = illimite).
MAX_STORED_POSTERS=2000

# --- Observabilite / options -------------------------------------------------
# Documentation OpenAPI : desactivee par defaut en production.
ENABLE_DOCS=false
# Optionnel : DSN Sentry. Laisser vide pour desactiver.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO
TZ=Europe/Paris
ENVIRONMENT=production

# --- Options avancees (facultatives) -----------------------------------------
# Les valeurs ci-dessous sont les valeurs par defaut du code. Ne les modifier
# qu'en connaissance de cause.
# "auto" : cookie Secure si X-Forwarded-Proto=https, sinon non.
COOKIE_SECURE=auto
# Taille maximale du corps JSON cote application (nginx plafonne deja a 64k).
MAX_REQUEST_BODY_BYTES=131072
# Taille maximale d'un ZIP multi-themes en memoire (octets).
MAX_ARCHIVE_BYTES=536870912
# Timeouts Celery (secondes) : soft puis hard, hard > soft.
TASK_SOFT_TIME_LIMIT=480
TASK_TIME_LIMIT=540
# Age maximal d'une tache avant de renvoyer un timeout au client (secondes).
TASK_MAX_AGE=900
# TTL des metadonnees d'ownership de tache (secondes).
TASK_RESULT_TTL=3600
# TTL du compteur de taches actives d'une session (secondes).
ACTIVE_JOB_TTL=900
# TTL des resultats Celery dans Redis (secondes).
CELERY_RESULT_TTL=3600
# Seuil de recyclage du processus enfant du worker (Ko).
WORKER_MAX_MEMORY_KB=1500000
# Nom de la file Celery.
CELERY_QUEUE=celery
# User-Agent envoye a Nominatim (doit identifier l'application).
NOMINATIM_USER_AGENT=MapPoster/2.3.2 (+https://github.com/simongrossi/maptoposter-web)
# Timeout des appels de geocodage (secondes).
GEOCODE_TIMEOUT=10

# --- OpenStreetMap / Overpass ------------------------------------------------
# Type de reseau OSMnx :
#   auto           = all <= 5 km, drive au-dela (recommande)
#   drive          = routes carrossables uniquement (grandes zones)
#   drive_service  = drive + voies de service
#   all            = toutes les voies pietonnes/cyclables (tres lourd)
#   walk, bike     = reseaux pietons / cyclables
OSM_NETWORK_TYPE=auto
# Timeout des requetes Overpass (secondes). 150 laisse le temps aux grandes
# zones de repondre sans bloquer indefiniment le worker.
OSM_REQUEST_TIMEOUT=150
# Endpoint Overpass. Changer uniquement si l'instance par defaut est lente
# ou inaccessible depuis le VPS.
OVERPASS_URL=https://overpass-api.de/api
# Forcer IPv4 pour OSMnx/requests. Sur les VPS dont IPv6 est mal route,
# cela evite d'attendre le timeout IPv6 avant chaque requete.
OSM_FORCE_IPV4=true

